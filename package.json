{
  "name": "verdaxis-exchange",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:native",
    "typecheck:native": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "i18n:check": "npx tsx scripts/check-translations.ts",
    "build:check": "npm run build:check:prod",
    "smoke:navigation:setup": "python3 -m pip install -r scripts/requirements-navigation-smoke.txt && python3 -m playwright install chromium",
    "smoke:navigation": "python3 scripts/smoke_navigation.py",
    "smoke:journeys": "python3 scripts/journeys/run_journeys.py --backend \"${VERDAXIS_BACKEND_TREE:-work/journeys-backend}\"",
    "smoke:journeys:record": "python3 scripts/journeys/run_journeys.py --backend \"${VERDAXIS_BACKEND_TREE:-work/journeys-backend}\" --screenshots record",
    "smoke:live": "node scripts/smoke-live.mjs",
    "verify": "npm run check:openapi && npm run test && npm run i18n:check && npm run build:prod && npm run build:check && npm run typecheck",
    "build:check:prod": "node scripts/check-build-artifacts.mjs --target production --root dist",
    "build:check:staging": "node scripts/check-build-artifacts.mjs --target staging --root dist",
    "check:openapi": "node scripts/check-openapi-source.mjs",
    "generate:api-types": "openapi-typescript openapi.json -o src/api/generated/openapi.d.ts",
    "check:api-types": "node scripts/check-api-types.mjs",
    "test:artifact-check": "node --test scripts/check-build-artifacts.test.mjs",
    "test:openapi-source": "node --test scripts/check-openapi-source.test.mjs",
    "test:release-smoke": "python3 scripts/test_smoke_release.py && bash scripts/release-vercel.sh --self-test",
    "smoke:release": "python3 scripts/smoke_release.py"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.21",
    "@testing-library/dom": "^10.4.1",
    "gsap": "^3.14.2",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.17",
    "lucide-react": "^0.554.0",
    "mapbox-gl": "^3.30.0",
    "motion": "^12.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.3",
    "react-i18next": "^16.5.8",
    "react-is": "^19.2.4",
    "react-joyride": "^2.9.3",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^22.14.0",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.24",
    "jsdom": "^26.0.0",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^7.3.7",
    "vitest": "4.1.11"
  }
}
