## Local development (uses vite proxy to avoid CORS)
VITE_API_URL=/api

## Production (server .env should use):
# VITE_API_URL=https://api.verdaxis.exchange/api

## Optional Umami v3 tracker. Leave either value empty to disable analytics.
# VITE_ANALYTICS_HOST=https://analytics.verdaxis.exchange
# VITE_ANALYTICS_WEBSITE_ID=00000000-0000-4000-8000-000000000000

# Required for the intelligence map (public pk. browser token).
VITE_MAPBOX_PUBLIC_TOKEN=

# Shows the admin member offboarding actions. Leave unset until the matching
# backend routes are enabled.
# VITE_OFFBOARDING_ENABLED=true
