## Staging environment — baked into bundle during `vite build --mode staging`
## Release runners reject process or .env.staging.local overrides.
VITE_API_URL=https://api-staging.verdaxis.exchange/api

## Set both values in the staging build environment to enable Umami.
VITE_ANALYTICS_HOST=https://api-staging.verdaxis.exchange
VITE_ANALYTICS_WEBSITE_ID=9ade1929-3ea9-4660-b352-b8d74f05266a
